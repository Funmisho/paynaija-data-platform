# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env before running `docker compose up`:
#   cp .env.example .env
# ==============================================================================

# User Permissions (Match host UID: run `id -u` on Linux/WSL/macOS)
AIRFLOW_UID=1000

# Airflow Web UI Credentials
AIRFLOW_WWW_USER=admin
AIRFLOW_WWW_PASSWORD=change_this_admin_password

# Airflow Internal Metadata Database (airflow-db)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_this_metadata_password
AIRFLOW_DB_NAME=airflow

# PayNaija Business Warehouse Database (paynaija-warehouse)
WAREHOUSE_USER=paynaija_user
WAREHOUSE_PASSWORD=change_this_warehouse_password
WAREHOUSE_DB=paynaija_dev

# Cryptographic Keys
# Generate Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Generate Secret key: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=

# ==============================================================================
# AIRFLOW VARIABLES (Auto-mapped on spin-up)
# ==============================================================================
AIRFLOW_VAR_ANOMALY_THRESHOLD_PERCENTAGE=0.15
AIRFLOW_VAR_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
AIRFLOW_VAR_REQUIRED_CURRENCIES='["NGN", "GHS", "KES"]'

AIRFLOW_VAR_SETTLEMENT_FILE_DIR=/opt/airflow/data
AIRFLOW_VAR_SIGNUPS_INPUT_PATH=/opt/airflow/data/signups.csv
AIRFLOW_VAR_SIGNUPS_CLEAN_PATH=/opt/airflow/data/cleaned_signups.csv
AIRFLOW_VAR_SIGNUPS_REJECTED_PATH=/opt/airflow/data/rejected_signups.csv